# WAVS N2K telemetry server - deployment configuration
#
# Copy to .env and edit. Nothing here requires a code change.
#   cp .env.example .env
#
# Precedence: --flag  >  real environment  >  this file  >  built-in default.
# Point at a different file with ENV_FILE=/etc/wavs/n2k.env
#
# Check what actually resolved:  node dist/server.js --print-config

# ---------------------------------------------------------------- source
# sim    synthetic frames, no hardware, any OS
# can    the real bus via SocketCAN (Linux only)
# replay a recorded candump capture
MODE=sim

# CAN interface, MODE=can only.
CAN_IF=can0

# Retry cadence while the interface is not yet up, ms. 0 disables retrying.
# systemd often starts this service before can0 is configured; retrying turns
# that from a crash loop into a log line.
CAN_RETRY_MS=5000

# ---------------------------------------------------------------- identity
# Stamped into the hello message and every snapshot. Change per vessel.
VESSEL_ID=WAVS-01

# ---------------------------------------------------------------- network
# 0.0.0.0 accepts from anywhere on the boat network.
# 127.0.0.1 refuses everything off-box; use it if the console runs on the Pi.
HOST=0.0.0.0
PORT=4001

# ---------------------------------------------------------------- rates
# Consolidated snapshot rate, Hz. Lower it on a constrained uplink.
STATE_HZ=5

# Discard a partial fast-packet sequence older than this, ms.
FAST_PACKET_TTL_MS=3000
# How often the TTL sweep runs, ms.
SWEEP_INTERVAL_MS=1000

# ---------------------------------------------------------------- operations
# error | info | debug   (debug logs every decoded PGN: verbose on a real bus)
LOG_LEVEL=info

# Bus statistics line + a `stats` WebSocket message, every N seconds. 0 = off.
# This is how you tell from a log that the bus is still alive.
STATS_INTERVAL_S=60

# How long shutdown waits for sockets before forcing exit, ms.
SHUTDOWN_GRACE_MS=2000

# ---------------------------------------------------------------- replay
# REPLAY_FILE=captures/candump-2026-08-05.log
REPLAY_SPEED=1
REPLAY_MAX_GAP_MS=250
REPLAY_LOOP=false
